# ==============================================================================
# B.A.N.K.R.U.T. — Przykładowa konfiguracja środowiska (.env.example)
# Skopiuj ten plik jako `.env`:
#   cp .env.example .env
# Puste wartości opcjonalnych kluczy API oraz list sezonów są traktowane jako
# brak wartości (None / ustawienie domyślne).
# ==============================================================================

# --- Docker Compose ---
# Tag obrazu pobieranego w docker-compose.yml:
# ghcr.io/adam-kulwicki/bankrut-backend:${BACKEND_IMAGE_TAG:-dev}
# Przykłady: dev, prod, latest
BACKEND_IMAGE_TAG=dev

# --- Klucze zewnętrznych API sportowych (opcjonalne) ---
# Football-Data.org v4 — bieżący sezon Premier League (puste = pomija bieżący sezon)
FOOTBALL_DATA_API_KEY=
# BALLDONTLIE v1/games — terminarz NBA, kwarty, dokładny czas UTC oraz fallback historii
BALLDONTLIE_API_KEY=
# TheSportsDB — ID ligi Euroligi (puste = pomija Euroligę)
THESPORTSDB_EUROLEAGUE_ID=

# --- Harmonogram i zakres importu danych (ETL / Ingest) ---
# Czy uruchamiać automatyczny harmonogram ETL w tle (false/0/no wyłącza)
INGEST_ENABLED=true
# Odstęp w minutach między kolejnymi cyklami ingestu
INGEST_INTERVAL_MINUTES=60

# Strategia wyboru źródła danych NBA:
#   auto        - historia i rozegrane mecze ze stats.nba.com (Base + Advanced),
#                 terminarz/kwarty/czas UTC oraz fallback historii z BALLDONTLIE
#   nba_stats   - wyłącznie stats.nba.com (akceptuje też: nba-stats, nbastats)
#   balldontlie - wyłącznie api.balldontlie.io (wymaga BALLDONTLIE_API_KEY)
INGEST_NBA_SOURCE=auto

# Sezony historyczne piłki nożnej (OpenFootball), rozdzielone przecinkami
# Puste = automatycznie 2 ostatnie zakończone sezony, np.: 2023-24,2024-25
INGEST_FOOTBALL_SEASONS=
# Sezony historyczne NBA (rok startu sezonu), rozdzielone przecinkami
# Puste = automatycznie 2 ostatnie zakończone sezony, np.: 2022,2023,2024
INGEST_NBA_SEASONS=
# Lata historyczne tenisa (archiwum Sackmanna), rozdzielone przecinkami
# Puste = automatycznie 2 ostatnie zakończone lata, np.: 2023,2024
INGEST_TENNIS_YEARS=
# Toury tenisowe do synchronizacji: ATP, WTA (rozdzielone przecinkami)
INGEST_TENNIS_TOURS=ATP

# --- Ustawienia serwera i bazy (tylko do lokalnego uruchomienia `cargo run` bez Dockera) ---
# UWAGA: `docker-compose.yml` ustawia poniższe zmienne automatycznie w sekcji `environment:`.
# Odkomentuj je wyłącznie podczas lokalnego uruchamiania poza Docker Compose.
# DATABASE_URL=postgres://postgres:password@localhost:5432/sports_db
# HOST=0.0.0.0
# PORT=3000
# RUST_LOG=backend=debug,tower_http=info,sqlx=warn
